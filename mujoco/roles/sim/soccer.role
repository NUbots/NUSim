# Full soccer simulation: physics + DDS bridge + locomotion + head camera + GameController supervisor + viewer
# (+ the browser viewer / recorder, which stays inactive unless --web or --record is given).
# ConsoleLog first so it captures startup logs.
k1sim_role(
  ConsoleLog
  Simulation
  SdkBridge
  Locomotion
  Camera
  Supervisor
  Viewer
  WebViewer
  Referee
)
