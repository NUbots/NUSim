<mujoco model="k1_robocup_scene">
  <!--
    RoboCup Humanoid League KidSize field for the vendored Booster K1 (see K1_22dof.xml /
    VENDORED.md): 9x6 m playing area + 1 m border, goal 2.6 m wide x 1.2 m high, centre circle
    radius 0.75 m, goal area 1x3 m, penalty area 2x5 m, penalty mark 1.5 m from the goal line.
    Layout, spawn poses and contact coefficients come from the Webots k1_robocup.wbt world. The
    Webots field and ball textures aren't redistributable, so the pitch is a green checker with
    painted line geoms.

    Solver settings (timestep 0.001, Newton, impratio 10) come from K1_22dof.xml.

    The ball body sits at the origin with its geom offset to the rest position (1.38, 0, 0.0785).
    K1_22dof.xml's keyframes only cover the robot (nq = 29), so MuJoCo zero-pads the ball's qpos in
    them, and they can't be redefined here because duplicate <key> names are rejected. With the
    offset on the geom, the zero-padded pose is the rest position.
  -->
  <include file="K1_22dof.xml"/>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.55 0.75" rgb2="0 0 0" width="512" height="512"/>
    <texture name="grass_tex" type="2d" builtin="checker" rgb1="0.06 0.35 0.08" rgb2="0.05 0.30 0.07"
              width="300" height="300" mark="edge" markrgb="0.08 0.4 0.1"/>
    <material name="grass_mat" texture="grass_tex" texrepeat="22 16" texuniform="true" reflectance="0.05" specular="0.1"/>
    <material name="post_mat" rgba="0.95 0.95 0.95 1"/>
    <material name="ball_mat" rgba="0.85 0.25 0.05 1"/>
    <!-- NUpbr ball_001 asset (mesh normalised to unit radius in Blender, UVs preserved) -->
    <mesh name="ball_visual" file="ball_001.obj" scale="0.0785 0.0785 0.0785"/>
    <texture name="ball_tex" type="2d" file="meshes/ball_001_color.png"/>
    <material name="ball_tex_mat" texture="ball_tex" specular="0.3" shininess="0.4"/>
  </asset>

  <visual>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.5 0.5 0.5" specular="0.2 0.2 0.2"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <worldbody>
    <light name="sun1" directional="true" pos="3 2 6" dir="-0.4 -0.3 -1" diffuse="0.7 0.7 0.65" specular="0.2 0.2 0.2" castshadow="true"/>
    <light name="sun2" directional="true" pos="-3 -2 6" dir="0.3 0.2 -1" diffuse="0.35 0.35 0.35" specular="0.05 0.05 0.05" castshadow="false"/>

    <!-- Pitch: half-size 5.5 x 4.0 m (11 x 8 m total = 9x6 field + 1m border), matching the Webots proto's grass extent. -->
    <geom name="floor" type="plane" pos="0 0 0" size="5.5 4.0 0.1" material="grass_mat" condim="3" friction="0.8 0.02 0.001"/>

    <!-- Field line markings (touchlines, goal lines, center line/circle/mark, goal areas, penalty areas, penalty marks). -->
